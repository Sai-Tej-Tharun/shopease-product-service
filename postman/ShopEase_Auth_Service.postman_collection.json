    {
      "name": "12 Me - expired token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Builds an already-expired HS256 token signed with the collection variable jwt_secret (must equal JWT_SECRET_KEY in .env)",
              "const b64 = o => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(o))).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_');",
              "const now = Math.floor(Date.now()/1000);",
              "const data = b64({alg:'HS256',typ:'JWT'}) + '.' + b64({sub:'1',role:'customer',iat:now-7200,exp:now-3600});",
              "const sig = CryptoJS.HmacSHA256(data, pm.collectionVariables.get('jwt_secret')).toString(CryptoJS.enc.Base64).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_');",
              "pm.collectionVariables.set('expired_token', data + '.' + sig);",
              "pm.request.headers.add({key:'Authorization', value:'Bearer ' + pm.collectionVariables.get('expired_token')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Message: Token has expired\", function () { pm.expect(pm.response.json().message).to.eql(\"Token has expired\"); });"
            ]
          }
        }
      ],
