# Copy this file to .env and replace every change-me value.
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=shopease_auth_db
MYSQL_USER=shopease_auth
MYSQL_PASSWORD=change-me
MYSQL_HOST_PORT=3307

MYSQL_HOST=localhost
MYSQL_PORT=3307

JWT_SECRET_KEY=change-me-use-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
